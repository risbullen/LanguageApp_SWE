 "units": [
  {
   "id": "fika",
   "title": "Fika",
   "visual": "☕",
   "lexicon_ids": [
    "sv_kopp",
    "sv_bulle",
    "sv_kaka",
    "sv_smorgas",
    "sv_glas",
    "sv_tarta"
   ],
   "grammar_focus": {
    "contrast": [
     "indef_sg",
     "indef_pl"
    ],
    "rule": "More than one: en-words usually add -ar, -or or -er (kopp → koppar, kaka → kakor). Many ett-words stay the same (ett glas → två glas)."
   },
   "dialogue": {
    "scene": "You're at a café counter in Stockholm. Order something.",
    "start": "n1",
    "nodes": [
     {
      "id": "n1",
      "speaker": "🧑‍🍳",
      "line": "Hej! Vad får det lov att vara?",
      "choices": [
       {
        "text": "En kopp kaffe, tack.",
        "next": "n2",
        "fit": "ok"
       },
       {
        "text": "Ett kopp kaffe, tack.",
        "next": "n2",
        "fit": "meh",
        "feedback": "Understood! But kopp is an en-word.",
        "recast": "En kopp kaffe? Absolut."
       },
       {
        "text": "Hej då!",
        "next": "n1",
        "fit": "no",
        "feedback": "That says goodbye before you've ordered."
       }
      ]
     },
     {
      "id": "n2",
      "speaker": "🧑‍🍳",
      "visual": "🥐",
      "line": "Vill du ha en kanelbulle till?",
      "choices": [
       {
        "text": "Ja, gärna!",
        "next": "n3",
        "fit": "ok"
       },
       {
        "text": "Nej tack, bara kaffe.",
        "next": "n3",
        "fit": "ok"
       },
       {
        "text": "Jag är en bulle.",
        "next": "n2",
        "fit": "no",
        "feedback": "You just said “I am a bun”."
       }
      ]
     },
     {
      "id": "n3",
      "speaker": "🧑‍🍳",
      "line": "Det blir fyrtiofem kronor.",
      "choices": [
       {
        "text": "Kan jag betala med kort?",
        "next": "n4",
        "fit": "ok"
       },
       {
        "text": "Varsågod.",
        "next": "n4",
        "fit": "ok"
       }
      ]
     },
     {
      "id": "n4",
      "speaker": "🧑‍🍳",
      "visual": "💳",
      "line": "Javisst, blippa här. Ha en fin dag!",
      "choices": [
       {
        "text": "Tack, detsamma!",
        "next": null,
        "fit": "ok"
       },
       {
        "text": "Tack så mycket!",
        "next": null,
        "fit": "ok"
       }
      ]
     }
    ]
   },
